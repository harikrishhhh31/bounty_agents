# Unified security platform configuration
PERPLEXITY_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=

BUGBOUNTY_WORKSPACE=./workspace
BUGBOUNTY_APPROVAL_MODE=deny
BUGBOUNTY_DRY_RUN=true
BUGBOUNTY_MAX_REQUESTS_PER_MINUTE=10
BUGBOUNTY_MODEL_TIMEOUT_SECONDS=30

# Dashboard API authentication. Provide either an inline token or a path to a
# file containing the token (the file takes precedence). When unset, the
# dashboard refuses to start in a non-local bind.
BUGBOUNTY_DASHBOARD_TOKEN=
BUGBOUNTY_DASHBOARD_TOKEN_FILE=

# Optional external scanners. Enable only tools you have installed and are
# authorised to run against your targets. Example:
# BUGBOUNTY_EXTERNAL_TOOLS=nuclei,zap,ffuf
